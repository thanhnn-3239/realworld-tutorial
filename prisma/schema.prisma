// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  description String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  tagList     Tag[]
  author      User      @relation("UserArticles", fields: [authorId], onDelete: Cascade, references: [id])
  authorId    Int
  favoritedBy User[]    @relation("UserFavorites")
  comments    Comment[]

  // Every listing and feed request sorts on createdAt, and Postgres creates no
  // index for the authorId foreign key that the feed join walks.
  @@index([createdAt])
  @@index([authorId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  body      String   @db.VarChar(255)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int

  @@index([articleId, createdAt])
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  articles Article[]
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  username      String         @unique
  // Null for accounts that authenticate only through a provider, and the state the
  // account-linking path leaves behind when it evicts a speculative password.
  password      String?
  image         String?
  bio           String?
  articles      Article[]      @relation("UserArticles")
  favorites     Article[]      @relation("UserFavorites")
  followedBy    User[]         @relation("UserFollows")
  following     User[]         @relation("UserFollows")
  comments      Comment[]
  authProviders AuthProvider[]
  refreshTokens RefreshToken[]
}

model AuthProvider {
  id                Int      @id @default(autoincrement())
  provider          String
  providerAccountId String
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @unique
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  // Points at the row that superseded this one. Deliberately a bare column rather than a
  // self-relation: nothing navigates the chain, it is only read as a replay flag.
  replacedById Int?      @unique
  createdAt    DateTime  @default(now())

  @@index([userId])
}

