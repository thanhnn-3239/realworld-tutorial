NODE_ENV=development
APP_PORT=3000
APP_NAME="NestJS API"
LOG_LEVEL=debug
DEBUG_SQL=false
API_PREFIX=api

JWT_SECRET=secret-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
BCRYPT_SALT_ROUNDS=10
DEMO_USER_PASSWORD=

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=realworld
DATABASE_URL=postgresql://root:secret@localhost:5432/realworld?schema=public
