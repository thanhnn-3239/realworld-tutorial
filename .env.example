NODE_ENV=development
APP_PORT=3000
APP_NAME="NestJS API"
LOG_LEVEL=debug
DEBUG_SQL=false
API_PREFIX=api

JWT_SECRET=secret-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
BCRYPT_SALT_ROUNDS=10
DEMO_USER_PASSWORD=

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=realworld
DATABASE_URL=postgresql://root:secret@localhost:5432/realworld?schema=public

# S3-compatible file storage (MinIO locally, AWS S3 in prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=realworld
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/realworld
STORAGE_REGION=us-east-1

# Background jobs (Redis)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=realworld

# Email delivery (Mailpit locally, SMTP provider in prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
MAIL_FROM=no-reply@realworld.test
MAILPIT_UI_PORT=8025

# Account link confirmation frontend URL
GOOGLE_LINK_CONFIRM_URL=http://localhost:3000/auth/google/link/confirm

# Kafka event streaming (Local KRaft container or Cloud Aiven)
KAFKA_PORT=9092
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=realworld-api
KAFKA_GROUP_ID=realworld-notification-group
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_USERNAME=
KAFKA_PASSWORD=
ENABLE_KAFKA=true

