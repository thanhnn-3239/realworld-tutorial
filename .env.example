NODE_ENV=development
APP_PORT=3000
APP_NAME="NestJS API"
LOG_LEVEL=debug
DEBUG_SQL=false
API_PREFIX=api

JWT_SECRET=secret-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
BCRYPT_SALT_ROUNDS=10
DEMO_USER_PASSWORD=

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=realworld
DATABASE_URL=postgresql://root:secret@localhost:5432/realworld?schema=public

# S3-compatible file storage (MinIO locally, AWS S3 in prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=realworld
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/realworld
STORAGE_REGION=us-east-1
