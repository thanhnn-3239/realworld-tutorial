APP_ENV_FILE=.env.e2e
NODE_ENV=test
APP_PORT=3300
APP_NAME="NestJS API E2E"
LOG_LEVEL=error
DEBUG_SQL=false
API_PREFIX=api

JWT_SECRET=e2e-only-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=4
DEMO_USER_PASSWORD=password123
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

DATABASE_PORT=55432
DATABASE_USERNAME=e2e
DATABASE_PASSWORD=e2e
DATABASE_NAME=realworld_e2e
DATABASE_URL=postgresql://e2e:e2e@postgres:5432/realworld_e2e?schema=public

STORAGE_API_PORT=59000
STORAGE_CONSOLE_PORT=59001
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=realworld-e2e
STORAGE_ACCESS_KEY=e2e-minio
STORAGE_SECRET_KEY=e2e-minio-secret
STORAGE_PUBLIC_URL=http://minio:9000/realworld-e2e
STORAGE_REGION=us-east-1
